# Copia este ficheiro para ".env" e preenche os valores. O ".env" NUNCA vai para o Git.

# Ligação à base de dados: utilizador, palavra-passe, computador, porta e nome da BD.
# Se a palavra-passe tiver caracteres especiais (@ / # ...), têm de ser codificados em URL.
DATABASE_URL=postgresql+psycopg://postgres:A_TUA_PASSWORD@localhost:5432/anicare_bd

# Chave que o Flask usa para assinar o cookie de sessão (quem está com login) e os tokens CSRF.
# Tem de ser longa, aleatória e secreta. Gera uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=muda-isto-para-uma-chave-longa-e-aleatoria

# 1 = modo de desenvolvimento (mostra erros detalhados). Em produção: 0.
DEBUG=1
